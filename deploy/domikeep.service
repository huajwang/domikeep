[Unit]
Description=Domikeep website
After=network-online.target

[Service]
User=domikeep
Group=domikeep
WorkingDirectory=/opt/domikeep
EnvironmentFile=/etc/domikeep.env
ExecStart=/opt/domikeep/.venv/bin/gunicorn domikeep.wsgi:application --bind 127.0.0.1:8001 --workers 1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
